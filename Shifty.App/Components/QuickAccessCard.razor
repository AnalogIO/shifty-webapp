@using Microsoft.AspNetCore.Components

<MudItem xs="12" sm="6" md="4">
    <MudLink Href="@Href" Underline="Underline.None" Style="display: block; height: 100%; color: inherit; text-decoration: none;" Class="dashboard-card-link">
        <MudCard Class="dashboard-card h-100">
            <MudCardContent Class="d-flex flex-column align-center text-center pa-6">
                <MudIcon Icon="@Icon" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h6" Class="mt-3">@Title</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                    @Description
                </MudText>
            </MudCardContent>
        </MudCard>
    </MudLink>
</MudItem>

@code {
    [Parameter] public string Href { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = string.Empty;
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Description { get; set; } = string.Empty;
}
